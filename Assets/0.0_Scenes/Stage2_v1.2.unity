  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c643a61334dc548a9593e6b053dc95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialHaptics: {fileID: 797093345}
  dialogueBlocks:
  - stage: 0
    beforeDialogue: "\uC6B0\uB9AC \uAC00\uAC8C\uC5D0 \uC5B4\uC11C\uC640\n\uC6B0\uB9AC\uC9D1
      \uBD95\uC5B4\uBE75\uC740 \uD2B9\uC774\uD55C \uBD95\uC5B4\uBE75\uC774\uC57C\n\uB2E4
      \uC775\uC73C\uBA74 \uD401 \uD280\uC5B4\uC624\uB974\uAC70\uB4E0\n\uB2E4 \uC775\uAE30
      \uC804\uC5D0 \uBD95\uC5B4\uBE75 \uD2C0\uC774 \n\uBA3C\uC800 \uB2EC\uADF8\uB77D
      \uAC70\uB9B4\uAC70\uC57C\n\uB2EC\uADF8\uB77D \uAC70\uB9AC\uB294 \uD2C0\uC744
      \uC798 \uC9C0\uCF1C\uBD10"
    duringText: "\uB2EC\uADF8\uB77D \uC18C\uB9AC\uB97C \uB4E4\uC5B4\uBCF4\uC138\uC694!\n\uD604\uC7AC
      {telegraphCount}/2"
    duringHintText: 
    afterDialogue: "\uC5B4\uB54C \uB2EC\uADF8\uB77D \uAC70\uB9AC\uB294\uAC74 \uC798
      \uCC3E\uC558\uC5B4?"
  - stage: 1
    beforeDialogue: "\uC774\uC81C \uB2EC\uADF8\uB77D \uAC70\uB9B0 \uD2C0\uC5D0\uC11C
      \n\uBD95\uC5B4\uBE75\uC774 \uD401 \uD280\uC5B4\uC624\uC744\uAC70\uC57C\n2\uBC88
      \uD280\uC5B4\uC624\uB97C\uAC70\uC57C \uC798 \uBD10\uBC14"
    duringText: "\uD401! \uD280\uC5B4\uB098\uC624\uB294 \uD0C0\uC774\uBC0D\uC744
      \uBCF4\uC138\uC694.\n\uD604\uC7AC {popCount}/2"
    duringHintText: "\uC7A1\uAE30 \uBD88\uAC00 (\uAD00\uCC30 \uB2E8\uACC4)"
    afterDialogue: "\uC5B4\uB54C \uC798 \uBD24\uC5B4?"
  - stage: 2
    beforeDialogue: "\uC774\uC81C \uC9C1\uC811 \uBD95\uC5B4\uBE75\uC744 \uC7A1\uC544\uBCFC\uAC70\uC57C\n\uD280\uC5B4\uC624\uB978
      \uBD95\uC5B4\uBE75\uC5D0 \uB808\uC774\uC800\uB97C \uB9DE\uCD94\uACE0\n\uC3D8\uBA74
      \uC7A1\uC744 \uC218 \uC788\uC5B4\n2\uBC88 \uC7A1\uC544\uBD10"
    duringText: "\uC7A1\uC544\uBCF4\uC138\uC694!\nGood \uC774\uC0C1 2\uD68C \uD544\uC694
      ({goodCount}/2)"
    duringHintText: "\uC591\uC190 \uC778\uB371\uC2A4 \uD2B8\uB9AC\uAC70\uB85C \uC7A1\uAE30"
    afterDialogue: "\uC798\uD558\uB294\uB370?"
  - stage: 3
    beforeDialogue: "\uAC00\uB054 \uBD95\uC5B4\uBE75\uC774 \n2\uAC1C \uB3D9\uC2DC\uC5D0
      \uD280\uC5B4\uB098\uC62C \uAC70\uC57C\n2\uAC1C\uAC00 \uB098\uC624\uAE30 \uC804\uC5D0
      \n\uD2B9\uBCC4\uD55C \uC74C\uC774 \uB4E4\uB9B4\uAC70\uC57C"
    duringText: "\uB450 \uAC1C \uB3D9\uC2DC\uC5D0!\n\uD604\uC7AC {specialCaught}/{specialTarget}"
    duringHintText: "\uC591\uC190 \uC778\uB371\uC2A4 \uD2B8\uB9AC\uAC70\uB85C \uC7A1\uAE30"
    afterDialogue: "\uC624 \uC774\uAC83\uB3C4 \uC798 \uC7A1\uB294\uB370?"
  - stage: 4
    beforeDialogue: "\uC774\uC81C \uB9C8\uC9C0\uB9C9 \uD328\uD134\uC774\uC57C\n\uC774\uBC88\uC5D0\uB294
      3\uAC1C\uC758 \uD2C0\uC5D0\uC11C \n\uC21C\uCC28\uC801\uC73C\uB85C \uD280\uC5B4\uC624\uB97C\uAC70\uC57C\n\uC774\uAC83\uB3C4
      \uC18C\uB9AC\uAC00 \uB2E4\uB974\uB2C8\uAE4C \uC798 \uB4E3\uACE0 \uC7A1\uC544\uBD10!"
    duringText: "3\uAC1C \uC5F0\uC18D!\n\uD604\uC7AC {specialCaught}/{specialTarget}"
    duringHintText: "\uC5F0\uC18D\uC73C\uB85C \uBE60\uB974\uAC8C \uD2B8\uB9AC\uAC70!"
    afterDialogue: "\uC644\uBCBD\uD574"
  - stage: 5
    beforeDialogue: "\uC774\uC81C \uBD95\uC5B4\uBE75 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD574\uBCF4\uC790\nA\uBC84\uD2BC\uC744
      \uB204\uB974\uBA74 \uBA54\uB274\uB97C \uC5F4 \uC218 \uC788\uC5B4"
    duringText: 
    duringHintText: 
    afterDialogue: "\uB108\uB77C\uBA74 \uC798 \uD560 \uC218 \uC788\uC744\uAC70\uC57C"
