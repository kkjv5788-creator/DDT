    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"\uC624\uB298 \uB108, \uAE40\uBC25 \uB2F4\uB2F9\uC774\uC57C.\""
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"\uC190\uB2D8 \uC624\uAE30 \uC804\uC5D0 \uAE30\uBCF8\uBD80\uD130
      \n\uBC15\uC544 \uB123\uC790. Yes?\""
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"Look. \uC55E\uC744 \uBD10.\""
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"\uC800\uAC8C \uB124 \uC624\uB298\uC758 \uC2DC\uD5D8\uC9C0\uC57C.\""
    conditionType: 2
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"Good. \uC800\uAC70\uB2E4.\""
    conditionType: 0
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"\uCE7C\uC740 \uC774\uBBF8 \uB4E4\uACE0 \uC788\uC9C0.\""
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"Okay. \uC190\uC740 \uC0B4\uC544\uC788\uB124.\""
    conditionType: 3
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "\"\uC774\uC81C \uBE44\uD2B8\uAC00 \uC624\uBA74\n\uD0C1! \uB0B4\uB824\uCCD0.\""
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  - dialogueText: "Skip\uC740 \uCEE8\uD2B8\uB864\uB7EC \n\"A\" \uD0A4\uB97C \uC785\uB825\uD574\uC8FC\uC138\uC694.\n\uB77C\uB514\uC624\uB97C
      \uD074\uB9AD\uD558\uBA74\n\uBCF8 \uAC8C\uC784 \uC2DC\uC791!!"
    conditionType: 1
    waitAfterCondition: 0.5
    autoAdvanceTime: 2
  gazeDetectionDistance: 5
  handMovementThreshold: 0.5
  gazeAngleThreshold: 30
  triggerButtonHintText: "[\uC624\uB978\uC190 \uD2B8\uB9AC\uAC70] \uB2E4\uC74C"
